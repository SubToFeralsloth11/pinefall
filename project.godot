; Engine configuration file.
config_version=5

[application]

config/name="Pinefall"
config/description="Cinematic Godot rendering showcase: CC0 Poly Haven pine forest."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
anti_aliasing/screen_space_roughness_limiter/enabled=true
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/texture_mipmap_bias=-0.5
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/atlas_16_bits=false
reflections/sky_reflections/roughness_layers=10
reflections/sky_reflections/ggx_samples=128
reflections/sky_reflections/fast_filter_high_quality=true
reflections/reflection_atlas/reflection_size=1024
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=3
camera/depth_of_field/depth_of_field_use_jitter=true
environment/ssao/quality=4
environment/ssao/half_size=false
environment/ssil/quality=4
environment/ssil/half_size=false
environment/screen_space_reflection/half_size=false
environment/subsurface_scattering/subsurface_scattering_quality=3
environment/glow/upscale_mode=1
environment/volumetric_fog/volume_size=160
environment/volumetric_fog/volume_depth=128
environment/volumetric_fog/use_filter=1
global_illumination/sdfgi/probe_ray_count=4
global_illumination/sdfgi/frames_to_converge=4
global_illumination/sdfgi/frames_to_update_lights=1
mesh_lod/lod_change/threshold_pixels=0.5
